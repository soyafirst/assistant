# Server Port
PORT=3000

# App Hosting URL
APP_URL="http://localhost:3000"

# Gemini API Key (Server-side default fallback or high-intelligence routing)
GEMINI_API_KEY=""

# Groq API Key (Free tier ultra-fast model for everyday PC commands and system actions)
GROQ_API_KEY=""

# Claude / Anthropic API Key (For complex analytical reasoning and advanced coding)
CLAUDE_API_KEY=""

# Claude Base URL (For proxy, OpenRouter, or custom Anthropic endpoint e.g. https://api.anthropic.com/v1)
CLAUDE_BASE_URL="https://api.anthropic.com/v1"
